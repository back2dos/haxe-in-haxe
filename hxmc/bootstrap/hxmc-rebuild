#!/usr/bin/env node
// `hxmc-rebuild`: builds the native compiler again from the package's (possibly
// edited) haxe/ and hxmc/ sources with the packaged WebAssembly compiler, and
// installs it as first use does (build.mjs --rebuild)
import { spawnSync } from 'node:child_process';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
const r = spawnSync(process.execPath, [path.join(path.dirname(fileURLToPath(import.meta.url)), 'build.mjs'), '--rebuild'], { stdio: 'inherit' });
process.exit(r.status ?? 1);
