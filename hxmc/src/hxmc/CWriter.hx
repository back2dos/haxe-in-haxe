package hxmc;

import backend.EmitC;
import backend.Ir;

// Development (hybrid) builds only: one C file with what hxmc does not
// generate itself yet. EmitC (prepared by Prep) supplies the C of every
// function; the ones compiled to machine code are left out and declared
// extern instead. Every function has external linkage, so native code and C
// call each other by name (the names are EmitC's: F_<function>).
@:access(backend.EmitC)
class CWriter {
	public static function write(e:EmitC, native:FuncInfo->Bool, withData:Bool):String {
		var p = e.p;
		var b = new StringBuf();
		b.add("// Generated by hxmc (development build): the functions hxmc does not compile yet\n");
		b.add("#include \"rt.h\"\n#include <stdio.h>\n#include <math.h>\n");
		b.add("typedef struct { uint64_t h; int32_t len, hash; uint16_t c[1]; } hx_slit;\n");
		b.add(@:privateAccess EmitC.PRELUDE);
		b.add(e.idsHeader());
		for (n in e.hostOrder)
			b.add(e.hostProtos.get(n) + ";\n");
		for (f in p.funcs)
			b.add(e.proto(f, false) + ";\n");
		if (withData) {
			b.add('const char *const rt_field_names[] = {${[for (n in e.fieldNames) @:privateAccess EmitC.cstr(n)].join(", ")}};\nconst int rt_nfield_names = ${e.fieldNames.length};\n');
			for (s in e.strOrder)
				b.add(e.strDef(s));
			b.add(e.data());
			b.add(e.mainBody());
		} else {
			// the data is native: declare what the C bodies use
			for (s in e.strOrder)
				b.add('extern hx_slit ${e.strNames.get(s)};\n');
			for (i in 0...p.globals.length)
				if (!Ir.isRef(p.globals[i].ty)) b.add('extern ${@:privateAccess EmitC.cty(p.globals[i].ty)} ${e.scalarGlobal(i)};\n');
			for (s in 0...p.selectors.length)
				b.add('extern void *const ${e.selNames[s]}[];\n');
		}
		for (f in p.funcs)
			if (!native(f)) b.add(e.proto(f, false) + " " + e.bodies.get(f).text);
		return b.toString();
	}
}
