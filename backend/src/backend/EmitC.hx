package backend;

import backend.Ir;

// EXPERIMENTAL (bench/WASM-BACKEND.md): IR -> C against backend/rt/rt.h.
// Reference-typed locals live in shadow-stack frame slots (`fr[k]`) so the
// copying GC can find and update them; scalars are plain C locals.
class EmitC {
	var p:Program;
	var b = new StringBuf();
	var fn:FuncInfo;
	var refSlot:Map<Local, Int>;
	var loops:Array<{id:Int, tries:Int}>;
	var tries:Array<String>;
	var nextLabel = 0;
	var tindexCount = 1; // 0 = Array
	var ptrmaps:Array<String> = ["2"];
	var boxTindex = new Map<String, Int>();

	public static function emit(p:Program):String
		return new EmitC(p).run();

	function new(p)
		this.p = p;

	function run():String {
		// type indices: Array (0), classes (1 + id), constructors, lambdas, boxes
		for (c in p.classes) {
			c.tindex = tindexCount++;
			ptrmaps.push(bitmap([for (f in c.fields) f.ty]));
		}
		for (e in p.enums)
			for (c in e.ctors) {
				c.tindex = tindexCount++;
				ptrmaps.push(bitmap([TI32].concat(c.params)));
			}
		for (l in p.lambdas) {
			l.tindex = tindexCount++;
			ptrmaps.push(bitmap([TI32].concat([for (c in l.captures) c.ty])));
		}
		for (k in ["i", "p"]) {
			boxTindex.set(k, tindexCount++);
			ptrmaps.push(k == "p" ? "1" : "0");
		}
		b.add("// Generated by backend/ (EXPERIMENTAL)\n#include \"rt.h\"\n#include <stdio.h>\n\n");
		b.add('static const uint64_t ptrmaps[] = {${ptrmaps.join(", ")}};\nconst uint64_t *rt_type_ptrmaps = ptrmaps;\n\n');
		b.add(PRELUDE);
		for (f in p.funcs)
			b.add(proto(f) + ";\n");
		// dispatch table: selector x class id
		var nc = p.classes.length;
		if (p.selectors.length > 0) {
			b.add('\nstatic void *dispatch[${p.selectors.length * nc}] = {');
			for (s in 0...p.selectors.length) {
				for (c in p.classes) {
					var m = c.findMethod(p.selectors[s].name);
					b.add(m != null && m.dispatchSel == s ? "(void *)" + m.name : "0");
					b.add(", ");
				}
			}
			b.add("};\n");
		}
		b.add("\n");
		for (f in p.funcs)
			func(f);
		b.add('int main(void) {\n\trt_init(${p.globals.length});\n');
		for (i in 0...p.globals.length) {
			var g = p.globals[i];
			var c = g.init;
			b.add('\trt_globals[$i] = rt_alloc(1, ${c.tindex}, K_OBJ);\n\tFI(rt_globals[$i], 0) = ${c.tag};\n');
		}
		b.add('\t${p.main.name}();\n\treturn 0;\n}\n');
		return b.toString();
	}

	static function bitmap(tys:Array<Ty>):String {
		var lo = 0, hi = 0;
		for (i in 0...tys.length)
			if (tys[i] != null && Ir.isRef(tys[i])) {
				if (i < 32) lo |= 1 << i else hi |= 1 << (i - 32);
			}
		return '0x${StringTools.hex(hi, 8)}${StringTools.hex(lo, 8)}ull';
	}

	static function cty(t:Ty):String
		return switch t {
			case TI32: "int32_t";
			case TF64: "double";
			case TVoid: "void";
			case TRef(_): "void *";
		}

	function proto(f:FuncInfo):String
		return 'static ${cty(f.ret)} ${f.name}(${f.args.length == 0 ? "void" : [for (a in f.args) cty(a.ty) + " a" + a.id].join(", ")})';

	function func(f:FuncInfo) {
		fn = f;
		refSlot = new Map();
		loops = [];
		tries = [];
		var roots = Roots.analyze(f);
		var n = 0;
		for (l => slot in roots.slots) {
			refSlot.set(l, slot);
			if (slot >= n) n = slot + 1;
		}
		b.add(proto(f) + " {\n");
		if (n > 0) b.add('\tvoid **fr = rt_sp;\n\trt_sp += $n;\n\tmemset(fr, 0, $n * sizeof(void *));\n');
		var vol = f.hasTry ? "volatile " : "";
		for (a in f.args)
			if (refSlot.exists(a)) b.add('\tfr[${refSlot.get(a)}] = a${a.id};\n');
			else b.add('\t$vol${cty(a.ty)} l${a.id} = a${a.id};\n');
		for (l in f.locals)
			if (!refSlot.exists(l)) b.add('\t$vol${cty(l.ty)} l${l.id} = 0;\n');
		stmts(f.body, "\t");
		if (f.ret == TVoid) b.add(n > 0 ? "\trt_sp = fr;\n" : "");
		else b.add("\t__builtin_unreachable();\n");
		b.add("}\n\n");
	}

	function popFrame():String
		return refSlot.keys().hasNext() ? "rt_sp = fr; " : "";

	function stmts(ss:Array<Stmt>, ind:String) {
		for (s in ss)
			stmt(s, ind);
	}

	function stmt(s:Stmt, ind:String) {
		switch s {
			case SSet(l, e):
				b.add('$ind${local(l)} = ${expr(e)};\n');
			case SExpr(e):
				b.add('$ind${expr(e)};\n');
			case SSetField(c, idx, obj, v):
				b.add(ind + store(obj, idx, c.fields[idx].ty, v) + ";\n");
			case SBoxSet(t, bx, v):
				b.add(ind + store(bx, 0, t, v) + ";\n");
			case SArrSet(elem, a, i, v):
				if (Ir.isRef(elem)) b.add('$ind{ *rt_sp++ = ${expr(v)}; aset_p(&${local(a)}, ${expr(i)}, rt_sp - 1); rt_sp--; }\n');
				else b.add('${ind}aset_i(&${local(a)}, ${expr(i)}, ${expr(v)});\n');
			case SArrPush(elem, a, v):
				if (Ir.isRef(elem)) b.add('$ind{ *rt_sp++ = ${expr(v)}; apush_p(&${local(a)}, rt_sp - 1); rt_sp--; }\n');
				else b.add('${ind}apush_i(&${local(a)}, ${expr(v)});\n');
			case SIf(c, x, y):
				b.add('${ind}if (${expr(c)}) {\n');
				stmts(x, ind + "\t");
				if (y.length > 0) {
					b.add('$ind} else {\n');
					stmts(y, ind + "\t");
				}
				b.add('$ind}\n');
			case SLoop(body):
				var id = nextLabel++;
				loops.push({id: id, tries: tries.length});
				b.add('${ind}for (;;) {\n');
				stmts(body, ind + "\t");
				b.add('$ind}\n${ind}brk$id:;\n');
				loops.pop();
			case SBreak:
				var lp = loops[loops.length - 1];
				b.add(ind + unwindTo(lp.tries) + 'goto brk${lp.id};\n');
			case SContinue:
				var lp = loops[loops.length - 1];
				b.add(ind + unwindTo(lp.tries) + "continue;\n");
			case SSwitch(e, cases, def):
				b.add('${ind}switch (${expr(e)}) {\n');
				for (c in cases) {
					for (v in c.values)
						b.add('${ind}case $v:\n');
					b.add('$ind{\n');
					stmts(c.body, ind + "\t");
					b.add('$ind\tbreak;\n$ind}\n');
				}
				b.add('${ind}default: {\n');
				stmts(def, ind + "\t");
				b.add('$ind}\n$ind}\n');
			case SReturn(null):
				b.add(ind + unwindTo(0) + popFrame() + "return;\n");
			case SReturn(e):
				b.add('$ind{ ${cty(fn.ret)} r = ${expr(e)}; ${unwindTo(0)}${popFrame()}return r; }\n');
			case SThrow(e):
				b.add('${ind}rt_throw(${expr(e)});\n');
			case STry(body, catches):
				var h = "h" + nextLabel++;
				b.add('$ind{\n$ind\trt_handler $h;\n$ind\t$h.prev = rt_hcur;\n$ind\t$h.sp = rt_sp;\n$ind\trt_hcur = &$h;\n');
				b.add('$ind\tif (RT_SETJMP($h.buf) == 0) {\n');
				tries.push(h);
				stmts(body, ind + "\t\t");
				tries.pop();
				b.add('$ind\t\trt_hcur = $h.prev;\n$ind\t} else {\n$ind\t\trt_hcur = $h.prev;\n$ind\t\trt_sp = $h.sp;\n');
				var first = true;
				for (c in catches) {
					var cond = c.c == null ? "1" : 'is_inst(rt_exn, ${c.c.tindex}, ${c.c.tindex + c.c.lastDescendant - c.c.id})';
					b.add('$ind\t\t${first ? "" : "else "}if ($cond) {\n$ind\t\t\t${local(c.l)} = rt_exn;\n$ind\t\t\trt_exn = 0;\n');
					stmts(c.body, ind + "\t\t\t");
					b.add('$ind\t\t}\n');
					first = false;
				}
				b.add('$ind\t\telse rt_throw(rt_exn);\n$ind\t}\n$ind}\n');
		}
	}

	// pops the exception handlers entered since `depth`
	function unwindTo(depth:Int):String
		return tries.length > depth ? 'rt_hcur = ${tries[depth]}.prev; ' : "";

	function local(l:Local):String {
		var s = refSlot.get(l);
		return s != null ? 'fr[$s]' : 'l${l.id}';
	}

	function store(obj:Ex, idx:Int, t:Ty, v:Ex):String {
		var o = expr(obj);
		return switch t {
			case TRef(_): 'rt_set_ptr($o, &FP($o, $idx), ${expr(v)})';
			case TF64: 'FD($o, $idx) = ${expr(v)}';
			case _: 'FI($o, $idx) = ${expr(v)}';
		}
	}

	function load(o:String, idx:Int, t:Ty):String
		return switch t {
			case TRef(_): 'FP($o, $idx)';
			case TF64: 'FD($o, $idx)';
			case _: 'FI($o, $idx)';
		}

	function expr(e:Ex):String {
		return switch e {
			case EInt(v): v == -2147483648 ? "(-2147483647 - 1)" : Std.string(v);
			case ENull(_): "((void *)0)";
			case ELocal(l): local(l);
			case EGlobal(g, _): 'rt_globals[$g]';
			case EBin(op, x, y):
				var a = expr(x), c = expr(y);
				switch op {
					case Add: 'IADD($a, $c)';
					case Sub: 'ISUB($a, $c)';
					case Mul: 'IMUL($a, $c)';
					case Mod: 'IMOD($a, $c)';
					case And: '($a & $c)';
					case Or: '($a | $c)';
					case Xor: '($a ^ $c)';
					case Shl: 'ISHL($a, $c)';
					case Shr: 'ISHR($a, $c)';
					case UShr: 'IUSHR($a, $c)';
					case Eq | RefEq: '($a == $c)';
					case Ne | RefNe: '($a != $c)';
					case Lt: '($a < $c)';
					case Le: '($a <= $c)';
					case Gt: '($a > $c)';
					case Ge: '($a >= $c)';
				}
			case ENot(x): '!(${expr(x)})';
			case EField(c, idx, obj): load(expr(obj), idx, c.fields[idx].ty);
			case ECast(_, x): expr(x);
			case EInstOf(c, x): 'is_inst(${expr(x)}, ${c.tindex}, ${c.tindex + c.lastDescendant - c.id})';
			case EEnumTag(x): 'FI(${expr(x)}, 0)';
			case EEnumParam(c, idx, x): load(expr(x), idx + 1, c.params[idx]);
			case EArrLen(a): 'ARR_LEN(${expr(a)})';
			case EArrGet(elem, a, i): Ir.isRef(elem) ? 'aget_p(${expr(a)}, ${expr(i)})' : 'aget_i(${expr(a)}, ${expr(i)})';
			case EBoxGet(t, bx): load(expr(bx), 0, t);
			case ECapture(l, idx, clos): load(expr(clos), idx + 1, l.captures[idx].ty);
			case ECall(f, args): '${f.name}(${[for (a in args) expr(a)].join(", ")})';
			case ECallDispatch(sel, sig, args):
				var ft = '${cty(sig.ret)} (*)(${[for (t in sig.args) cty(t)].join(", ")})';
				'((${ft})dispatch[${sel * p.classes.length} + FI(${expr(args[0])}, 0)])(${[for (a in args) expr(a)].join(", ")})';
			case ECallClos(s, clos, args):
				var ft = '${cty(s.ret)} (*)(${["void *"].concat([for (t in s.args) cty(t)]).join(", ")})';
				var c = expr(clos);
				'((${ft})FP($c, 0))(${[c].concat([for (a in args) expr(a)]).join(", ")})';
			case ECallHost("Host_printInt", [x]): 'printf("%d\\n", ${expr(x)})';
			case ECallHost(n, _): throw "unknown host function " + n;
			case ENewObj(c): '({ void *o = rt_alloc(${c.fields.length}, ${c.tindex}, K_OBJ); FI(o, 0) = ${c.id}; o; })';
			case ENewEnum(c, args):
				var s = '({ void *o = rt_alloc_init(${c.params.length + 1}, ${c.tindex}, K_OBJ); FP(o, 0) = 0; FI(o, 0) = ${c.tag}; ';
				for (i in 0...args.length)
					s += load("o", i + 1, c.params[i]) + ' = ${expr(args[i])}; ';
				s + "o; })";
			case ENewArr(elem, vs):
				var raw = Ir.isRef(elem) ? 0 : 1;
				var s = '({ void *o = rt_arr_new($raw, ${vs.length}, 0); ';
				for (i in 0...vs.length)
					s += raw == 1 ? '((int32_t *)ARR_DATA(o))[$i] = ${expr(vs[i])}; ' : 'rt_set_ptr(ARR_DATA(o), &FP(ARR_DATA(o), $i), ${expr(vs[i])}); ';
				s + 'ARR_LEN(o) = ${vs.length}; o; })';
			case ENewClos(l, caps):
				var s = '({ void *o = rt_alloc_init(${l.captures.length + 1}, ${l.tindex}, K_OBJ); FP(o, 0) = (void *)${l.fn.name}; ';
				for (i in 0...caps.length)
					s += load("o", i + 1, l.captures[i].ty) + ' = ${expr(caps[i])}; ';
				s + "o; })";
			case ENewBox(t, v):
				var k = Ir.isRef(t) ? "p" : "i";
				'({ void *o = rt_alloc_init(1, ${boxTindex.get(k)}, K_OBJ); FP(o, 0) = 0; ${load("o", 0, t)} = ${expr(v)}; o; })';
		}
	}

	static final PRELUDE = "
static inline int is_inst(void *o, uint32_t lo, uint32_t hi) {
	return o && KIND(o) == K_OBJ && TINDEX(o) >= lo && TINDEX(o) <= hi;
}
static inline int32_t aget_i(void *a, int32_t i) {
	return (uint32_t)i < (uint32_t)ARR_LEN(a) ? ((int32_t *)ARR_DATA(a))[i] : 0;
}
static inline void *aget_p(void *a, int32_t i) {
	return (uint32_t)i < (uint32_t)ARR_LEN(a) ? FP(ARR_DATA(a), i) : 0;
}
static inline void apush_i(void **slot, int32_t v) {
	void *a = *slot;
	if ((uint32_t)ARR_LEN(a) >= 2 * NSLOTS(ARR_DATA(a))) { rt_arr_grow(slot, 1); a = *slot; }
	((int32_t *)ARR_DATA(a))[ARR_LEN(a)++] = v;
}
static inline void apush_p(void **slot, void **v) {
	void *a = *slot;
	if ((uint32_t)ARR_LEN(a) >= NSLOTS(ARR_DATA(a))) { rt_arr_grow(slot, 0); a = *slot; }
	void *d = ARR_DATA(a);
	rt_set_ptr(d, &FP(d, ARR_LEN(a)), *v);
	ARR_LEN(a)++;
}
static inline void aset_i(void **slot, int32_t i, int32_t v) {
	while ((uint32_t)i >= (uint32_t)ARR_LEN(*slot)) apush_i(slot, 0);
	((int32_t *)ARR_DATA(*slot))[i] = v;
}
static inline void aset_p(void **slot, int32_t i, void **v) {
	void *z = 0;
	while ((uint32_t)i >= (uint32_t)ARR_LEN(*slot)) apush_p(slot, &z);
	void *d = ARR_DATA(*slot);
	rt_set_ptr(d, &FP(d, i), *v);
}

";
}

// Which reference locals must live in shadow-stack slots: those live across a
// GC point (a call or allocation), like the live slots an OCaml frame table
// records. The others stay in C locals (registers). Functions with a try
// block root every reference local, since the handler may observe them after
// any call in the body.
class Roots {
	var rooted = new Map<Local, Bool>();
	var points:Array<Map<Local, Bool>> = []; // live sets after each statement
	public var slots = new Map<Local, Int>();
	var brk:Array<Map<Local, Bool>> = [];
	var cont:Array<Map<Local, Bool>> = [];

	function new() {}

	public static function analyze(f:FuncInfo):Roots {
		var r = new Roots();
		if (f.hasTry) {
			var n = 0;
			for (l in f.args.concat(f.locals))
				if (Ir.isRef(l.ty)) r.slots.set(l, n++);
			return r;
		}
		var entry = r.seq(f.body, new Map());
		r.points.push(entry);
		r.color(f);
		return r;
	}

	// greedy slot assignment: rooted locals live at the same point get different slots
	function color(f:FuncInfo) {
		var interfere = new Map<Local, Map<Local, Bool>>();
		for (l in rooted.keys())
			interfere.set(l, new Map());
		for (pt in points) {
			var live = [for (l in pt.keys()) if (rooted.exists(l)) l];
			for (a in live)
				for (b in live)
					if (a != b) interfere.get(a).set(b, true);
		}
		// arguments are stored at entry: they all interfere with each other
		var args = [for (a in f.args) if (rooted.exists(a)) a];
		for (a in args)
			for (b in args)
				if (a != b) interfere.get(a).set(b, true);
		for (l in f.args.concat(f.locals)) {
			if (!rooted.exists(l)) continue;
			var used = new Map<Int, Bool>();
			for (o in interfere.get(l).keys())
				if (slots.exists(o)) used.set(slots.get(o), true);
			var s = 0;
			while (used.exists(s))
				s++;
			slots.set(l, s);
		}
	}

	static function copy(m:Map<Local, Bool>):Map<Local, Bool> {
		var r = new Map();
		for (k in m.keys())
			r.set(k, true);
		return r;
	}

	static function union(a:Map<Local, Bool>, b:Map<Local, Bool>):Map<Local, Bool> {
		var r = copy(a);
		for (k in b.keys())
			r.set(k, true);
		return r;
	}

	static function same(a:Map<Local, Bool>, b:Map<Local, Bool>):Bool {
		for (k in a.keys())
			if (!b.exists(k)) return false;
		for (k in b.keys())
			if (!a.exists(k)) return false;
		return true;
	}

	function across(live:Map<Local, Bool>) {
		for (l in live.keys())
			if (Ir.isRef(l.ty)) rooted.set(l, true);
	}

	static function uses(e:Ex, acc:Map<Local, Bool>) {
		switch e {
			case EInt(_) | ENull(_) | EGlobal(_, _):
			case ELocal(l): acc.set(l, true);
			case EBin(_, a, b):
				uses(a, acc);
				uses(b, acc);
			case ENot(a) | EField(_, _, a) | ECast(_, a) | EInstOf(_, a) | EEnumTag(a) | EEnumParam(_, _, a) | EArrLen(a) | EBoxGet(_, a) | ECapture(_, _, a) | ENewBox(_, a):
				uses(a, acc);
			case EArrGet(_, a, i):
				uses(a, acc);
				uses(i, acc);
			case ECall(_, args) | ECallDispatch(_, _, args) | ECallHost(_, args) | ENewEnum(_, args) | ENewArr(_, args) | ENewClos(_, args):
				for (a in args)
					uses(a, acc);
			case ECallClos(_, c, args):
				uses(c, acc);
				for (a in args)
					uses(a, acc);
			case ENewObj(_):
		}
	}

	// GC point; `alloc`: operands are read after the allocation
	static function gcPoint(e:Ex):Int
		return switch e {
			case ECall(_) | ECallDispatch(_) | ECallClos(_): 1;
			case ENewObj(_) | ENewEnum(_) | ENewArr(_) | ENewClos(_) | ENewBox(_): 2;
			case _: 0;
		}

	// backward: returns the live set before `ss` given the live set after it
	function seq(ss:Array<Stmt>, out:Map<Local, Bool>):Map<Local, Bool> {
		var live = out;
		var i = ss.length;
		while (i-- > 0)
			live = stmt(ss[i], live);
		return live;
	}

	function expr(e:Ex, after:Map<Local, Bool>, def:Null<Local>):Map<Local, Bool> {
		var u = new Map();
		uses(e, u);
		var rest = copy(after);
		if (def != null) rest.remove(def);
		switch gcPoint(e) {
			case 1: across(rest);
			case 2: across(union(rest, u));
			case _:
		}
		return union(rest, u);
	}

	function stmt(s:Stmt, out:Map<Local, Bool>):Map<Local, Bool> {
		switch s {
			case SSet(l, _):
				var pt = copy(out);
				pt.set(l, true);
				points.push(pt);
			case _:
				points.push(out);
		}
		return switch s {
			case SSet(l, e): expr(e, out, l);
			case SExpr(e): expr(e, out, null);
			case SSetField(_, _, o, v) | SBoxSet(_, o, v):
				var u = copy(out);
				uses(o, u);
				uses(v, u);
				u;
			case SArrSet(_, a, i, v):
				rooted.set(a, true); // passed by slot address
				across(out);
				var u = copy(out);
				u.set(a, true);
				uses(i, u);
				uses(v, u);
				u;
			case SArrPush(_, a, v):
				rooted.set(a, true);
				across(out);
				var u = copy(out);
				u.set(a, true);
				uses(v, u);
				u;
			case SIf(c, x, y):
				var u = union(seq(x, out), seq(y, out));
				uses(c, u);
				u;
			case SLoop(body):
				var entry = new Map<Local, Bool>();
				while (true) {
					brk.push(out);
					cont.push(entry);
					var n = seq(body, entry);
					brk.pop();
					cont.pop();
					if (same(n, entry)) break;
					entry = union(entry, n);
				}
				entry;
			case SBreak: brk[brk.length - 1];
			case SContinue: cont[cont.length - 1];
			case SSwitch(e, cases, def):
				var u = seq(def, out);
				for (c in cases)
					u = union(u, seq(c.body, out));
				uses(e, u);
				u;
			case SReturn(e):
				var u = new Map();
				if (e != null) uses(e, u);
				u;
			case SThrow(e):
				var u = new Map();
				uses(e, u);
				u;
			case STry(_, _): throw "try in a function without hasTry";
		}
	}
}
