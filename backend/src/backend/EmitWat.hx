package backend;

import backend.Ir;

// EXPERIMENTAL (bench/WASM-BACKEND.md): IR -> WebAssembly text with GC types,
// assembled and optimized by Binaryen. Objects are structs with prefix
// subtyping, enum constructors are struct subtypes of their enum, closures
// are structs holding a typed function reference, virtual and interface
// calls go through one call_indirect table indexed by selector and class id.
// Exceptions use the legacy exception-handling instructions Node 22 ships.
class EmitWat {
	var p:Program;
	var b = new StringBuf();
	var fn:FuncInfo;
	var labels:Array<String>; // enclosing loop labels: "brkN" / "contN"
	var nextLabel = 0;
	var arrKinds = new Map<String, Ty>();
	var boxKinds = new Map<String, Ty>();
	var exnLocals:Int;

	public static function emit(p:Program):String
		return new EmitWat(p).run();

	function new(p)
		this.p = p;

	function run():String {
		var funcs = new StringBuf();
		var saved = b;
		for (f in p.funcs) {
			b = new StringBuf();
			func(f);
			funcs.add(b.toString());
		}
		b = saved;
		b.add(";; Generated by backend/ (EXPERIMENTAL)\n(module\n (rec\n");
		b.add("  (type $Obj (sub (struct (field i32))))\n");
		for (c in p.classes)
			if (c.sup != null) b.add('  (type ${tyName(c)} (sub ${tyName(c.sup)} (struct ${fields([for (f in c.fields) f.ty], 1)})))\n');
		b.add("  (type $Enum (sub (struct (field i32))))\n");
		for (e in p.enums) {
			b.add('  (type $$E_${e.name} (sub $$Enum (struct (field i32))))\n');
			for (c in e.ctors)
				b.add('  (type ${ctorName(c)} (sub final $$E_${e.name} (struct (field i32) ${[for (t in c.params) '(field ${wt(t)})'].join(" ")})))\n');
		}
		for (s in p.sigs) {
			b.add('  (type $$Clos_${s.id} (sub (struct (field (ref $$fn_${s.id})))))\n');
			b.add('  (type $$fn_${s.id} (func (param (ref $$Clos_${s.id})) ${params(s.args)} ${result(s.ret)}))\n');
			b.add('  (type $$sig_${s.id} (func ${params(s.args)} ${result(s.ret)}))\n');
		}
		for (l in p.lambdas)
			b.add('  (type $$L_${l.id} (sub final $$Clos_${l.sig.id} (struct (field (ref $$fn_${l.sig.id})) ${[for (c in l.captures) '(field ${wt(c.ty)})'].join(" ")})))\n');
		for (k => t in arrKinds) {
			b.add('  (type $$vec_$k (array (mut ${wt(t)})))\n');
			b.add('  (type $$Arr_$k (struct (field (mut i32)) (field (mut (ref $$vec_$k)))))\n');
		}
		for (k => t in boxKinds)
			b.add('  (type $$Box_$k (struct (field (mut ${wt(t)}))))\n');
		b.add(" )\n");
		b.add(' (import "env" "printInt" (func $$Host_printInt (param i32)))\n');
		b.add(" (tag $exn (param anyref))\n");
		for (i in 0...p.globals.length) {
			var c = p.globals[i].init;
			b.add(' (global $$g$i (ref ${ctorName(c)}) (struct.new ${ctorName(c)} (i32.const ${c.tag})))\n');
		}
		var nc = p.classes.length;
		if (p.selectors.length > 0) {
			b.add(' (table $$dispatch ${p.selectors.length * nc} funcref)\n (elem (table $$dispatch) (i32.const 0) funcref');
			for (s in 0...p.selectors.length)
				for (c in p.classes) {
					var m = c.findMethod(p.selectors[s].name);
					b.add(m != null && m.dispatchSel == s ? ' (ref.func $$${m.name})' : " (ref.null func)");
				}
			b.add(")\n");
		}
		if (p.lambdas.length > 0) b.add(' (elem declare func ${[for (l in p.lambdas) "$" + l.fn.name].join(" ")})\n');
		b.add(funcs.toString());
		for (k => t in arrKinds)
			b.add(arrayHelpers(k, t));
		b.add(' (func $$imod (param $$a i32) (param $$b i32) (result i32)\n  (if (result i32) (i32.or (i32.eqz (local.get $$b)) (i32.eq (local.get $$b) (i32.const -1))) (then (i32.const 0)) (else (i32.rem_s (local.get $$a) (local.get $$b)))))\n');
		b.add(' (export "main" (func $$${p.main.name}))\n)\n');
		return b.toString();
	}

	function fields(tys:Array<Ty>, from:Int):String {
		var r = ["(field i32)"];
		for (i in from...tys.length)
			r.push('(field (mut ${wt(tys[i])}))');
		return r.join(" ");
	}

	function params(tys:Array<Ty>):String
		return [for (t in tys) '(param ${wt(t)})'].join(" ");

	static function result(t:Ty):String
		return t == TVoid ? "" : '(result ${wtStatic(t)})';

	static function wtStatic(t:Ty):String
		return switch t {
			case TI32: "i32";
			case TF64: "f64";
			case _: throw "ref type needs an emitter";
		}

	function tyName(c:ClassInfo):String
		return c.sup == null ? "$Obj" : "$C_" + c.name;

	static function ctorName(c:CtorInfo):String
		return '$$K_${c.en.name}_${c.name}';

	function key(t:Ty):String
		return switch t {
			case TI32: "i32";
			case TF64: "f64";
			case TRef(RObj(c)): "o_" + c.name;
			case TRef(REnum(e)): "e_" + e.name;
			case TRef(RCtor(c)): "k_" + c.en.name + "_" + c.name;
			case TRef(RArr(t)): "a_" + key(t);
			case TRef(RClos(s)): "c_" + s.id;
			case TRef(RBox(t)): "b_" + key(t);
			case TRef(RAny): "any";
			case TVoid: "void";
		}

	function heap(r:RefTy):String
		return switch r {
			case RObj(c): tyName(c);
			case REnum(e): "$E_" + e.name;
			case RCtor(c): ctorName(c);
			case RArr(t):
				var k = key(t);
				arrKinds.set(k, t);
				"$Arr_" + k;
			case RClos(s): "$Clos_" + s.id;
			case RBox(t):
				var k = key(t);
				boxKinds.set(k, t);
				"$Box_" + k;
			case RAny: "any";
		}

	function wt(t:Ty):String
		return switch t {
			case TI32: "i32";
			case TF64: "f64";
			case TVoid: throw "void value";
			case TRef(r): '(ref null ${heap(r)})';
		}

	function result2(t:Ty):String
		return t == TVoid ? "" : ' (result ${wt(t)})';

	function func(f:FuncInfo) {
		fn = f;
		labels = [];
		exnLocals = 0;
		var body = new StringBuf();
		var saved = b;
		b = body;
		stmts(f.body, "  ");
		b = saved;
		b.add(' (func $$${f.name}');
		if (f.lambda != null) {
			// closure bodies must have exactly the closure's function type
			b.add(' (type $$fn_${f.lambda.sig.id})');
		} else if (f.dispatchSel >= 0) {
			// call_indirect compares types by identity within the recursion group
			b.add(' (type $$sig_${p.selectors[f.dispatchSel].sig.id})');
		}
		for (a in f.args)
			b.add(' (param $$l${a.id} ${a == f.args[0] && f.lambda != null ? '(ref $$Clos_${f.lambda.sig.id})' : wt(a.ty)})');
		b.add(result2(f.ret) + "\n");
		for (l in f.locals)
			b.add('  (local $$l${l.id} ${wt(l.ty)})\n');
		for (i in 0...exnLocals)
			b.add('  (local $$exn$i anyref)\n');
		b.add(body.toString());
		if (f.ret != TVoid) b.add("  (unreachable)\n");
		b.add(" )\n");
	}

	function stmts(ss:Array<Stmt>, ind:String) {
		for (s in ss)
			stmt(s, ind);
	}

	function stmt(s:Stmt, ind:String) {
		switch s {
			case SSet(l, e):
				b.add('$ind(local.set $$l${l.id} ${expr(e)})\n');
			case SExpr(e):
				b.add(ind + (exprTy(e) == TVoid ? expr(e) : '(drop ${expr(e)})') + "\n");
			case SSetField(c, idx, obj, v):
				b.add('$ind(struct.set ${tyName(c)} $idx ${expr(obj)} ${expr(v)})\n');
			case SBoxSet(t, bx, v):
				b.add('$ind(struct.set ${heap(RBox(t))} 0 ${expr(bx)} ${expr(v)})\n');
			case SArrSet(elem, a, i, v):
				heap(RArr(elem));
				b.add('$ind(call $$aset_${key(elem)} (local.get $$l${a.id}) ${expr(i)} ${expr(v)})\n');
			case SArrPush(elem, a, v):
				heap(RArr(elem));
				b.add('$ind(call $$apush_${key(elem)} (local.get $$l${a.id}) ${expr(v)})\n');
			case SIf(c, x, y):
				b.add('$ind(if ${expr(c)}\n$ind (then\n');
				stmts(x, ind + "  ");
				b.add('$ind )');
				if (y.length > 0) {
					b.add('\n$ind (else\n');
					stmts(y, ind + "  ");
					b.add('$ind )');
				}
				b.add(")\n");
			case SLoop(body):
				var id = nextLabel++;
				labels.push('$id');
				b.add('$ind(block $$brk$id (loop $$cont$id\n');
				stmts(body, ind + " ");
				b.add('$ind (br $$cont$id)))\n');
				labels.pop();
			case SBreak:
				b.add('$ind(br $$brk${labels[labels.length - 1]})\n');
			case SContinue:
				b.add('$ind(br $$cont${labels[labels.length - 1]})\n');
			case SSwitch(e, cases, def):
				switchStmt(e, cases, def, ind);
			case SReturn(null):
				b.add('$ind(return)\n');
			case SReturn(e):
				b.add('$ind(return ${expr(e)})\n');
			case SThrow(e):
				b.add('$ind(throw $$exn ${expr(e)})\n');
			case STry(body, catches):
				var id = nextLabel++;
				var x = exnLocals++;
				b.add('$ind(try $$try$id\n$ind (do\n');
				stmts(body, ind + "  ");
				b.add('$ind )\n$ind (catch $$exn\n$ind  (local.set $$exn$x (pop anyref))\n');
				var close = 0;
				for (c in catches) {
					if (c.c == null) {
						b.add('$ind  (local.set $$l${c.l.id} (local.get $$exn$x))\n');
						stmts(c.body, ind + "  ");
						close = -1;
						break;
					}
					b.add('$ind  (if (ref.test (ref ${tyName(c.c)}) (local.get $$exn$x))\n$ind   (then\n');
					b.add('$ind    (local.set $$l${c.l.id} (ref.cast (ref null ${tyName(c.c)}) (local.get $$exn$x)))\n');
					stmts(c.body, ind + "    ");
					b.add('$ind   )\n$ind   (else\n');
					close++;
				}
				if (close >= 0) {
					b.add('$ind    (rethrow $$try$id)\n');
					for (i in 0...close)
						b.add('$ind   ))\n');
				}
				b.add('$ind ))\n');
		}
	}

	function switchStmt(e:Ex, cases:Array<{values:Array<Int>, body:Array<Stmt>}>, def:Array<Stmt>, ind:String) {
		var min = 0x7FFFFFFF, max = -0x7FFFFFFF;
		for (c in cases)
			for (v in c.values) {
				if (v < min) min = v;
				if (v > max) max = v;
			}
		var id = nextLabel++;
		if (cases.length == 0 || max - min > 64) {
			// sparse: if-chain
			var lo = "$sw" + id;
			b.add('$ind(block $lo\n');
			for (c in cases) {
				var cond = [for (v in c.values) '(i32.eq ${expr(e)} (i32.const $v))'];
				var cs = cond[0];
				for (i in 1...cond.length)
					cs = '(i32.or $cs ${cond[i]})';
				b.add('$ind (if $cs (then\n');
				stmts(c.body, ind + "  ");
				b.add('$ind  (br $lo)))\n');
			}
			stmts(def, ind + " ");
			b.add('$ind)\n');
			return;
		}
		var targets = [];
		for (v in min...max + 1) {
			var t = '$$sw${id}_def';
			for (i in 0...cases.length)
				if (cases[i].values.indexOf(v) >= 0) t = '$$sw${id}_$i';
			targets.push(t);
		}
		b.add('$ind(block $$sw${id}_end\n');
		b.add('$ind(block $$sw${id}_def\n');
		var i = cases.length;
		while (i-- > 0)
			b.add('$ind(block $$sw${id}_$i\n');
		b.add('$ind (br_table ${targets.join(" ")} $$sw${id}_def (i32.sub ${expr(e)} (i32.const $min)))\n');
		for (i in 0...cases.length) {
			b.add('$ind)\n');
			stmts(cases[i].body, ind + " ");
			b.add('$ind (br $$sw${id}_end)\n');
		}
		b.add('$ind)\n');
		stmts(def, ind + " ");
		b.add('$ind)\n');
	}

	function exprTy(e:Ex):Ty
		return switch e {
			case ECall(f, _): f.ret;
			case ECallDispatch(_, s, _): s.ret;
			case ECallClos(s, _, _): s.ret;
			case ECallHost(_, _): TVoid;
			case _: TI32; // anything else yields a value
		}

	function default_(t:Ty):String
		return switch t {
			case TI32: "(i32.const 0)";
			case TF64: "(f64.const 0)";
			case TRef(r): '(ref.null ${heap(r)})';
			case TVoid: throw "void";
		}

	function expr(e:Ex):String {
		return switch e {
			case EInt(v): '(i32.const $v)';
			case ENull(t): default_(t);
			case ELocal(l): '(local.get $$l${l.id})';
			case EGlobal(g, _): '(global.get $$g$g)';
			case EBin(op, x, y):
				var a = expr(x), c = expr(y);
				var o = switch op {
					case Add: "i32.add";
					case Sub: "i32.sub";
					case Mul: "i32.mul";
					case Mod: "call $imod";
					case And: "i32.and";
					case Or: "i32.or";
					case Xor: "i32.xor";
					case Shl: "i32.shl";
					case Shr: "i32.shr_s";
					case UShr: "i32.shr_u";
					case Eq: "i32.eq";
					case Ne: "i32.ne";
					case Lt: "i32.lt_s";
					case Le: "i32.le_s";
					case Gt: "i32.gt_s";
					case Ge: "i32.ge_s";
					case RefEq: "ref.eq";
					case RefNe: "ref.ne";
				};
				o == "ref.ne" ? '(i32.eqz (ref.eq $a $c))' : '($o $a $c)';
			case ENot(x): '(i32.eqz ${expr(x)})';
			case EField(c, idx, obj): '(struct.get ${tyName(c)} $idx ${expr(obj)})';
			case ECast(TRef(r), x): '(ref.cast (ref null ${heap(r)}) ${expr(x)})';
			case ECast(_, x): expr(x);
			case EInstOf(c, x): '(ref.test (ref ${tyName(c)}) ${expr(x)})';
			case EEnumTag(x): '(struct.get $$Enum 0 ${expr(x)})';
			case EEnumParam(c, idx, x): '(struct.get ${ctorName(c)} ${idx + 1} (ref.cast (ref ${ctorName(c)}) ${expr(x)}))';
			case EArrLen(a):
				var k = switch exTyOf(a) {
					case TRef(RArr(t)): heap(RArr(t));
					case _: throw "length of non-array";
				};
				'(struct.get $k 0 ${expr(a)})';
			case EArrGet(elem, a, i):
				heap(RArr(elem));
				'(call $$aget_${key(elem)} ${expr(a)} ${expr(i)})';
			case EBoxGet(t, bx): '(struct.get ${heap(RBox(t))} 0 ${expr(bx)})';
			case ECapture(l, idx, clos): '(struct.get $$L_${l.id} ${idx + 1} (ref.cast (ref $$L_${l.id}) ${expr(clos)}))';
			case ECall(f, args): '(call $$${f.name} ${[for (a in args) expr(a)].join(" ")})';
			case ECallDispatch(sel, sig, args):
				'(call_indirect $$dispatch (type $$sig_${sig.id}) ${[for (a in args) expr(a)].join(" ")} (i32.add (i32.const ${sel * p.classes.length}) (struct.get $$Obj 0 ${expr(args[0])})))';
			case ECallClos(s, clos, args):
				var c = '(ref.as_non_null ${expr(clos)})';
				'(call_ref $$fn_${s.id} $c ${[for (a in args) expr(a)].join(" ")} (struct.get $$Clos_${s.id} 0 $c))';
			case ECallHost(n, args): '(call $$$n ${[for (a in args) expr(a)].join(" ")})';
			case ENewObj(c): '(struct.new ${tyName(c)} (i32.const ${c.id}) ${[for (i in 1...c.fields.length) default_(c.fields[i].ty)].join(" ")})';
			case ENewEnum(c, args): '(struct.new ${ctorName(c)} (i32.const ${c.tag}) ${[for (a in args) expr(a)].join(" ")})';
			case ENewArr(elem, vs):
				var k = key(elem);
				heap(RArr(elem));
				var data = vs.length == 0 ? '(array.new_default $$vec_$k (i32.const 4))' : '(array.new_fixed $$vec_$k ${vs.length} ${[for (v in vs) expr(v)].join(" ")})';
				'(struct.new $$Arr_$k (i32.const ${vs.length}) $data)';
			case ENewClos(l, caps): '(struct.new $$L_${l.id} (ref.func $$${l.fn.name}) ${[for (c in caps) expr(c)].join(" ")})';
			case ENewBox(t, v): '(struct.new ${heap(RBox(t))} ${expr(v)})';
		}
	}

	// static type of a pure expression (only what array lengths need)
	function exTyOf(e:Ex):Ty
		return switch e {
			case ELocal(l): l.ty;
			case EField(c, idx, _): c.fields[idx].ty;
			case EEnumParam(c, idx, _): c.params[idx];
			case EBoxGet(t, _): t;
			case ECapture(l, idx, _): l.captures[idx].ty;
			case EArrGet(t, _, _): t;
			case _: throw "type of " + e.getName();
		}

	function arrayHelpers(k:String, t:Ty):String {
		var w = wt(t);
		var d = default_(t);
		return ' (func $$aget_$k (param $$a (ref null $$Arr_$k)) (param $$i i32) (result $w)
  (if (result $w) (i32.lt_u (local.get $$i) (struct.get $$Arr_$k 0 (local.get $$a)))
   (then (array.get $$vec_$k (struct.get $$Arr_$k 1 (local.get $$a)) (local.get $$i)))
   (else $d)))
 (func $$apush_$k (param $$a (ref null $$Arr_$k)) (param $$v $w)
  (local $$d (ref null $$vec_$k)) (local $$nd (ref null $$vec_$k)) (local $$n i32)
  (local.set $$d (struct.get $$Arr_$k 1 (local.get $$a)))
  (local.set $$n (struct.get $$Arr_$k 0 (local.get $$a)))
  (if (i32.ge_u (local.get $$n) (array.len (local.get $$d)))
   (then
    (local.set $$nd (array.new_default $$vec_$k (select (i32.const 4) (i32.shl (local.get $$n) (i32.const 1)) (i32.lt_u (local.get $$n) (i32.const 4)))))
    (array.copy $$vec_$k $$vec_$k (local.get $$nd) (i32.const 0) (local.get $$d) (i32.const 0) (local.get $$n))
    (struct.set $$Arr_$k 1 (local.get $$a) (ref.as_non_null (local.get $$nd)))
    (local.set $$d (local.get $$nd))))
  (array.set $$vec_$k (local.get $$d) (local.get $$n) (local.get $$v))
  (struct.set $$Arr_$k 0 (local.get $$a) (i32.add (local.get $$n) (i32.const 1))))
 (func $$aset_$k (param $$a (ref null $$Arr_$k)) (param $$i i32) (param $$v $w)
  (block $$done (loop $$grow
   (br_if $$done (i32.lt_u (local.get $$i) (struct.get $$Arr_$k 0 (local.get $$a))))
   (call $$apush_$k (local.get $$a) $d)
   (br $$grow)))
  (array.set $$vec_$k (struct.get $$Arr_$k 1 (local.get $$a)) (local.get $$i) (local.get $$v)))
';
	}
}
