import sys.FileSystem;
import sys.io.File;

// Writes shim/CaBundle.hx (into the directory given) from a PEM file: Mozilla's
// CA certificates as curl publishes them (https://curl.se/docs/caextract.html),
// which lix trusts besides the system's, as node (and so the npm package) does.
//   <haxe> -cp tools/lix --run CaBundle <cacert.pem> <sha256> <out dir>
class CaBundle {
	static function main() {
		var args = Sys.args();
		var pem = args[0], sha = args[1], out = args[2];
		var data = File.getBytes(pem);
		if (haxe.crypto.Sha256.make(data).toHex() != sha) {
			Sys.stderr().writeString('CaBundle: $pem does not have the expected sha256\n');
			Sys.exit(1);
		}
		// the certificates only (the comments name their owners, not all in ASCII)
		var certs = [], cur:Array<String> = null;
		for (line in ~/\r?\n/g.split(data.toString())) {
			if (StringTools.startsWith(line, "-----BEGIN CERTIFICATE-----")) cur = [];
			if (cur != null) {
				cur.push(line);
				if (StringTools.startsWith(line, "-----END CERTIFICATE-----")) {
					certs.push(cur.join("\n"));
					cur = null;
				}
			}
		}
		FileSystem.createDirectory('$out/shim');
		var target = '$out/shim/CaBundle.hx';
		File.saveContent(target + ".tmp", 'package shim;\n\n// generated by tools/lix/CaBundle.hx from ${haxe.io.Path.withoutDirectory(pem)} (${certs.length} certificates)\n'
			+ 'class CaBundle {\n\tpublic static final PEM = ${haxe.Json.stringify(certs.join("\n") + "\n")};\n}\n');
		FileSystem.rename(target + ".tmp", target);
	}
}
