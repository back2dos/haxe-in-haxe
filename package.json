{
  "name": "hxmc",
  "version": "0.0.0-dev",
  "description": "The Haxe compiler ported to Haxe, with hxmc built in (native executables and WebAssembly); runs as WebAssembly until its native build for this machine is ready",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "bin": {
    "haxe": "hxmc/bootstrap/haxe",
    "hxmc-rebuild": "hxmc/bootstrap/hxmc-rebuild"
  },
  "files": [
    "haxe/src/",
    "haxe/upstream/std/",
    "hxmc/*.hx",
    "hxmc/a64/",
    "hxmc/ir/",
    "hxmc/wasm/",
    "hxmc/x64/",
    "hxmc/std/",
    "hxmc/bootstrap/*.mjs",
    "hxmc/bootstrap/haxe",
    "hxmc/bootstrap/hxmc-rebuild",
    "hxmc/bootstrap/haxe.wasm",
    "hxmc/bootstrap/hxmc-std/",
    "hxmc/bootstrap/rt/",
    "dist/haxe",
    "COPYING",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": ["linux", "darwin", "win32"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benmerckx/haxe-in-haxe.git"
  }
}
