{
  "name": "hxmc",
  "version": "0.1.0",
  "description": "The Haxe compiler ported to Haxe, with hxmc built in: native executables for Linux, macOS and Windows (x86-64, ARM64) and WebAssembly",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "bin": {
    "haxe": "hxmc/bootstrap/haxe",
    "hxmc-rebuild": "hxmc/bootstrap/hxmc-rebuild"
  },
  "scripts": {
    "postinstall": "node hxmc/bootstrap/postinstall.mjs"
  },
  "files": [
    "haxe/src/",
    "haxe/upstream/std/",
    "hxmc/src/",
    "hxmc/std/",
    "hxmc/bootstrap/*.mjs",
    "hxmc/bootstrap/haxe",
    "hxmc/bootstrap/hxmc-rebuild",
    "hxmc/bootstrap/haxe.wasm",
    "hxmc/bootstrap/hxmc-std/",
    "hxmc/bootstrap/rt/",
    "dist/haxe",
    "COPYING",
    "LICENSE"
  ],
  "optionalDependencies": {
    "@hxmc/linux-x64": "0.1.0",
    "@hxmc/linux-arm64": "0.1.0",
    "@hxmc/darwin-x64": "0.1.0",
    "@hxmc/darwin-arm64": "0.1.0",
    "@hxmc/win32-x64": "0.1.0",
    "@hxmc/win32-arm64": "0.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benmerckx/hxmc.git"
  }
}
