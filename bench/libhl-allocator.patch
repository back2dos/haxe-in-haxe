+		case HI32: case HF32: esize = 4; break;
+		case HPACKED: esize = 0; break;
+		default: esize = 8; break;
+		}
+		varray *a = (varray*)hlc_slice_alloc((int)sizeof(varray) + esize * size, ptr ? MEM_KIND_DYNAMIC : MEM_KIND_NOPTR);
+		if( a ) { a->t = &hlt_array; a->at = at; a->size = size; return a; }
+	}
+	return hl_alloc_array(at, size);
+}
+
+static inline __attribute__((always_inline)) vvirtual *hlc_alloc_virtual( hl_type *t ) {
+	hl_type_virtual *vt = t->virt;
+	int i, nf = vt->nfields;
+	vvirtual *v = (vvirtual*)hlc_slice_alloc(vt->dataSize + (int)sizeof(vvirtual) + (int)sizeof(void*) * nf, MEM_KIND_DYNAMIC);
+	if( !v ) return hl_alloc_virtual(t);
+	void **fields = (void**)(v + 1);
+	v->t = t; // value, next and the data are already zero
+	for(i=0;i<nf;i++) fields[i] = (char*)v + vt->indexes[i];
+	return v;
+}
+
+static inline __attribute__((always_inline)) vbyte *hlc_alloc_bytes( int size ) {
+	vbyte *b = size > 0 ? (vbyte*)hlc_slice_alloc(size, MEM_KIND_NOPTR) : NULL;
+	return b ? b : hl_alloc_bytes(size);
+}
+
+#define hl_alloc_obj hlc_alloc_obj
+#define hl_alloc_enum hlc_alloc_enum
+#define hl_alloc_closure_ptr hlc_alloc_closure_ptr
+#define hl_alloc_array hlc_alloc_array
+#define hl_alloc_virtual hlc_alloc_virtual
+#define hl_alloc_bytes hlc_alloc_bytes
+#endif
+
+#if defined(HLC_BOOT) && !defined(HLC_NO_INLINE_CAST)
+// Inline fast path for hl_dyn_castp (cast.c): a value already of the static
+// type, or a Dynamic holding a reference-typed value of exactly the target
+// type, needs no runtime call. HNULL keeps the runtime path (boxed values).
+#define HLC_DYN_REF_KINDS ((1 << HFUN) | (1 << HOBJ) | (1 << HARRAY) | (1 << HVIRTUAL) | (1 << HDYNOBJ) | (1 << HENUM))
+static inline __attribute__((always_inline)) void *hlc_dyn_castp( void *data, hl_type *t, hl_type *to ) {
+	if( !(hl_track.flags & HL_TRACK_CAST) ) {
+		if( t == to && t->kind != HNULL ) return *(void**)data;
+		if( t->kind == HDYN ) {
+			vdynamic *v = *(vdynamic**)data;
+			if( v == NULL ) return NULL;
+			if( v->t == to && ((1 << to->kind) & HLC_DYN_REF_KINDS) ) return v;
+		}
+	}
+	return hl_dyn_castp(data, t, to);
+}
+#define hl_dyn_castp hlc_dyn_castp
+#endif
+
 #endif
