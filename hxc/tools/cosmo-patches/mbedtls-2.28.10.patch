mbedtls 2.28.10 for Cosmopolitan Libc (cosmocc), applied by hxc/tools/cosmo-deps.sh.

- entropy_poll.c: the platform entropy source is getrandom(), which
  Cosmopolitan provides on every host OS (Windows included), instead of
  reading /dev/urandom.

--- a/library/entropy_poll.c
+++ b/library/entropy_poll.c
@@ -96,6 +96,18 @@
 #endif /* SYS_getrandom */
 #endif /* __linux__ || __midipix__ */
 
+#if defined(__COSMOPOLITAN__)
+/* Cosmopolitan: getrandom() works on every host OS (Linux, macOS, Windows,
+ * the BSDs), unlike /dev/urandom */
+#include <errno.h>
+#include <sys/random.h>
+#define HAVE_GETRANDOM
+static int getrandom_wrapper(void *buf, size_t buflen, unsigned int flags)
+{
+    return getrandom(buf, buflen, flags);
+}
+#endif /* __COSMOPOLITAN__ */
+
 #if defined(__FreeBSD__) || defined(__DragonFly__)
 #include <sys/param.h>
 #if (defined(__FreeBSD__) && __FreeBSD_version >= 1200000) || \
