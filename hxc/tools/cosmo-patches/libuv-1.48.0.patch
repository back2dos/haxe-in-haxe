+/* Cosmopolitan's errno constants hold the host OS's values and are not
+ * compile-time constants: compare at run time. Errors libuv has no name for
+ * stay negated system errors (all below 4000 in magnitude, so they cannot
+ * clash with the fixed codes).
+ */
+int uv__cosmo_err(int e) {
+  if (e <= 0)
+    return e;
+#define X(name) if (e == name) return UV__##name;
+  X(EAGAIN) X(EINTR) X(ENOENT) X(EBADF) X(EINVAL) X(EPIPE) X(ECONNRESET)
+  X(ECONNREFUSED) X(EADDRINUSE) X(EACCES) X(EEXIST) X(ENOTDIR) X(EISDIR)
+  X(ENOTEMPTY) X(ETIMEDOUT) X(ECANCELED) X(ENOSYS) X(ENOTCONN) X(EPERM)
+  X(E2BIG) X(EADDRNOTAVAIL) X(EAFNOSUPPORT) X(EALREADY) X(EBUSY)
+#ifdef ECHARSET
+  X(ECHARSET)
+#endif
+  X(ECONNABORTED) X(EDESTADDRREQ) X(EFAULT) X(EHOSTUNREACH) X(EIO)
+  X(EISCONN) X(ELOOP) X(EMFILE) X(EMSGSIZE) X(ENAMETOOLONG) X(ENETDOWN)
+  X(ENETUNREACH) X(ENFILE) X(ENOBUFS) X(ENODEV) X(ENOMEM)
+#ifdef ENONET
+  X(ENONET)
+#endif
+  X(ENOSPC) X(ENOTSOCK) X(ENOTSUP) X(EPROTO) X(EPROTONOSUPPORT)
+  X(EPROTOTYPE) X(EROFS) X(ESHUTDOWN) X(ESPIPE) X(ESRCH) X(ETXTBSY) X(EXDEV)
+  X(EFBIG) X(ENOPROTOOPT) X(ERANGE) X(ENXIO) X(EMLINK)
+#ifdef EHOSTDOWN
+  X(EHOSTDOWN)
+#endif
+#ifdef EREMOTEIO
+  X(EREMOTEIO)
+#endif
+  X(ENOTTY)
+#ifdef EFTYPE
+  X(EFTYPE)
+#endif
+  X(EILSEQ) X(EOVERFLOW)
+#ifdef ESOCKTNOSUPPORT
+  X(ESOCKTNOSUPPORT)
+#endif
+#ifdef ENODATA
+  X(ENODATA)
+#endif
+#ifdef EUNATCH
+  X(EUNATCH)
+#endif
+#undef X
+#ifdef EOPNOTSUPP
+  /* distinct from ENOTSUP on macOS */
+  if (e == EOPNOTSUPP)
+    return UV__ENOTSUP;
+#endif
+  return -e;
+}
