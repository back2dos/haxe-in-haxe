+
+int uv__random_cosmo(void* buf, size_t buflen) {
+  /* getrandom() works on every host OS (RtlGenRandom/ProcessPrng on
+   * Windows, getentropy or the kernel's call elsewhere) */
+  char* p;
+  ssize_t n;
+
+  p = buf;
+  while (buflen > 0) {
+    n = getrandom(p, buflen > 256 ? 256 : buflen, 0);
+    if (n == -1) {
+      if (errno == EINTR)
+        continue;
+      return UV__ERR(errno);
+    }
+    p += n;
+    buflen -= n;
+  }
+  return 0;
+}
+
+
+int uv_exepath(char* buffer, size_t* size) {
+  const char* path;
+  size_t len;
+
+  if (buffer == NULL || size == NULL || *size == 0)
+    return UV_EINVAL;
+
+  path = GetProgramExecutableName();
+  if (path == NULL || *path == '\0')
+    return UV_ENOENT;
+
+  len = strlen(path);
+  if (len > *size - 1)
+    len = *size - 1;
+  memcpy(buffer, path, len);
+  buffer[len] = '\0';
+  *size = len;
+  return 0;
+}
+
+
+int uv_resident_set_memory(size_t* rss) {
+  /* the peak, not the current resident set: the only portable figure */
+  struct rusage ru;
+
+  if (getrusage(RUSAGE_SELF, &ru))
+    return UV__ERR(errno);
+  *rss = (size_t) ru.ru_maxrss * 1024;
+  return 0;
+}
+
+
+int uv_uptime(double* uptime) {
+  struct sysinfo info;
+
+  if (sysinfo(&info) < 0)
+    return UV__ERR(errno);
+  *uptime = info.uptime;
+  return 0;
+}
+
+
+int uv_cpu_info(uv_cpu_info_t** cpu_infos, int* count) {
+  /* the number of CPUs only: model, speed and times are not portable */
+  uv_cpu_info_t* ci;
+  long n;
+  int i;
+
+  n = sysconf(_SC_NPROCESSORS_ONLN);
+  if (n < 1)
+    n = 1;
+  ci = uv__calloc(n, sizeof(*ci));
+  if (ci == NULL)
+    return UV_ENOMEM;
+  for (i = 0; i < n; i++) {
+    ci[i].model = uv__strdup("unknown");
+    if (ci[i].model == NULL) {
+      uv_free_cpu_info(ci, i);
+      return UV_ENOMEM;
+    }
+  }
+  *cpu_infos = ci;
+  *count = n;
+  return 0;
+}
+
+
+uint64_t uv_get_constrained_memory(void) {
+  return 0;  /* Memory constraints are unknown. */
+}
+
+
+uint64_t uv_get_available_memory(void) {
+  return uv_get_free_memory();
+}
