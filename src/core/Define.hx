package core;

import haxe.crypto.Md5;
import haxe.ds.StringMap;

/**
 * Batch-compiler define state, ported from haxe/src/core/define.ml.
 *
 * The upstream strict define registry is generated by prebuild from
 * `src-json/defines.json` as DefineList.  It is intentionally not included
 * yet: this module therefore exposes raw string defines only.  In particular,
 * default values, deprecated names, documentation, and signature-neutral
 * registry entries are unavailable until that generated registry is ported.
 * `getSignature` uses MD5 hex rather than OCaml's binary Digest.string result,
 * because arbitrary digest bytes are not valid Haxe UTF-8 Strings.
 */
typedef DefineContext = {
	var values:StringMap<String>;
	var definesSignature:Null<String>;
}

class Define {
	public static function emptyDefines():DefineContext {
		return {values: new StringMap(), definesSignature: null};
	}

	public static inline function rawDefined(ctx:DefineContext, key:String):Bool {
		return ctx.values.exists(key);
	}

	/** Throws when the define is absent, like PMap.find in the OCaml source. */
	public static function rawDefinedValue(ctx:DefineContext, key:String):String {
		var value = ctx.values.get(key);
		if (value == null && !ctx.values.exists(key)) throw 'Define not found: $key';
		return value;
	}

	public static function rawDefinedValueSafe(ctx:DefineContext, key:String, ?defaultValue = ""):String {
		return rawDefined(ctx, key) ? rawDefinedValue(ctx, key) : defaultValue;
	}

	public static function rawDefineValue(ctx:DefineContext, key:String, value:String):Void {
		ctx.values.set(key, value);
		ctx.definesSignature = null;
	}

	public static inline function rawDefine(ctx:DefineContext, key:String):Void {
		rawDefineValue(ctx, key, "1");
	}

	public static function rawUndefine(ctx:DefineContext, key:String):Void {
		ctx.values.remove(key);
		ctx.definesSignature = null;
	}

	public static function getSignature(ctx:DefineContext):String {
		if (ctx.definesSignature != null) return ctx.definesSignature;

		var defines:Array<String> = [];
		for (key => value in ctx.values) {
			// Keep this normalization synchronized with conditional-compilation
			// identifier parsing, as in define.ml.
			var sanitized = key.split("-").join("_");
			// DefineList.is_signature_neutral is deliberately unavailable until
			// the generated strict registry is ported, so every raw key counts.
			var entry = sanitized + "=" + value;
			if (defines.indexOf(entry) == -1) defines.push(entry);
		}
		defines.sort(Reflect.compare);
		ctx.definesSignature = Md5.encode(defines.join("@"));
		return ctx.definesSignature;
	}
}
