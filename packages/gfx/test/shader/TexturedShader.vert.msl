#include <metal_stdlib>
using namespace metal;
struct TexVertex {
	float2 pos;
	float2 uv;
};
struct TexVaryings {
	float4 pos;
	float2 uv;
	float lift;
};
TexVaryings vs(TexVertex v, texture2d<float> height, sampler height_smp) {
	float4 t = float4(v.pos, 0.0, 1.0);
	float2 t_2 = v.uv;
	return TexVaryings{t, t_2, height.sample(height_smp, v.uv, level(0.0)).x};
}
struct StageIn {
	float2 pos [[attribute(0)]];
	float2 uv [[attribute(1)]];
};
struct StageOut {
	float4 pos [[position]];
	float2 uv [[user(locn0)]];
	float lift [[user(locn1)]];
};
vertex StageOut main0(StageIn i [[stage_in]], texture2d<float> tex_0 [[texture(0)]], sampler smp_0 [[sampler(0)]]) {
	TexVaryings r = vs(TexVertex{i.pos, i.uv}, tex_0, smp_0);
	return StageOut{r.pos, r.uv, r.lift};
}
