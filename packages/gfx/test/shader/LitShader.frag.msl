#include <metal_stdlib>
using namespace metal;
struct LitVaryings {
	float3 normal;
	float4 clip;
	float2 uv;
	float shade;
};
struct Material {
	float4 tint;
	int steps;
};
float posterize(float x, int steps) {
	if (steps < 2) {
		return x;
	}
	return floor(x * float(steps)) / float(steps - 1);
}
float4 fs(LitVaryings i, Material m) {
	float glow = 0.0;
	int t = 0;
	int t_2 = m.steps;
	while (t < t_2) {
		int k = t;
		t += 1;
		glow += 1.0 / float(k + 2);
	}
	float3 color = m.tint.xyz * (0.1 + posterize(i.shade, m.steps));
	if (i.uv.x > 0.5) {
		color = color.zyx;
	} else if (i.uv.y < 0.25) {
		color = 1.0 - color;
	}
	float check = ((int(i.uv.x * 8.0) % 2) == 0) ? 1.0 : 0.5;
	return float4(clamp((color * check) + (glow * 0.01), float3(0.0), float3(1.0)), m.tint.w);
}
struct Material_buffer {
	float4 tint;
	int steps;
};
struct StageOut {
	float4 clip [[position]];
	float3 normal [[user(locn0)]];
	float2 uv [[user(locn1)]];
	float shade [[user(locn2)]];
};
fragment float4 main0(StageOut i [[stage_in]], constant Material_buffer& u_1 [[buffer(1)]]) {
	return fs(LitVaryings{i.normal, i.clip, i.uv, i.shade}, Material{u_1.tint, u_1.steps});
}
