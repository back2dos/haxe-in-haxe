#include <metal_stdlib>
using namespace metal;
struct InstanceVertex {
	float2 corner;
	float2 at;
	float size;
	float angle;
	float3 color;
};
struct InstanceField {
	float2 scale;
	float time;
};
struct InstanceVaryings {
	float4 pos;
	float3 color;
	float2 corner;
};
InstanceVaryings vs(InstanceVertex v, InstanceField f) {
	float a = v.angle + f.time;
	float c = cos(a);
	float s = sin(a);
	float2 p = (float2((v.corner.x * c) - (v.corner.y * s), (v.corner.x * s) + (v.corner.y * c)) * v.size) + v.at;
	return InstanceVaryings{float4(p * f.scale, 0.0, 1.0), v.color, v.corner};
}
struct InstanceField_buffer {
	float2 scale;
	float time;
};
struct StageIn {
	float2 corner [[attribute(0)]];
	float2 at [[attribute(1)]];
	float size [[attribute(2)]];
	float angle [[attribute(3)]];
	float3 color [[attribute(4)]];
};
struct StageOut {
	float4 pos [[position]];
	float3 color [[user(locn0)]];
	float2 corner [[user(locn1)]];
};
vertex StageOut main0(StageIn i [[stage_in]], constant InstanceField_buffer& u_0 [[buffer(0)]]) {
	InstanceVaryings r = vs(InstanceVertex{i.corner, i.at, i.size, i.angle, i.color}, InstanceField{u_0.scale, u_0.time});
	return StageOut{r.pos, r.color, r.corner};
}
