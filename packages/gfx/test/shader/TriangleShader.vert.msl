#include <metal_stdlib>
using namespace metal;
struct Vertex {
	float2 pos;
	float3 color;
};
struct Varyings {
	float4 pos;
	float3 color;
};
Varyings vs(Vertex v) {
	return Varyings{float4(v.pos, 0.0, 1.0), v.color};
}
struct StageIn {
	float2 pos [[attribute(0)]];
	float3 color [[attribute(1)]];
};
struct StageOut {
	float4 pos [[position]];
	float3 color [[user(locn0)]];
};
vertex StageOut main0(StageIn i [[stage_in]]) {
	Varyings r = vs(Vertex{i.pos, i.color});
	return StageOut{r.pos, r.color};
}
