#include <metal_stdlib>
using namespace metal;
struct FeatureVaryings {
	float4 pos;
	float2 uv;
	float4 color;
	float mode;
};
float4 fs(FeatureVaryings i, texture2d<float> mask, sampler mask_smp, texture2d<float> image, sampler image_smp) {
	float m = mask.sample(mask_smp, i.uv, level(0.0)).x;
	float4 c = image.sample(image_smp, i.uv, level(0.0));
	if (i.mode < 0.5) {
		return i.color;
	}
	if (i.mode < 1.5) {
		return i.color * m;
	}
	return c * i.color;
}
struct StageOut {
	float4 pos [[position]];
	float2 uv [[user(locn0)]];
	float4 color [[user(locn1)]];
	float mode [[user(locn2)]];
};
fragment float4 main0(StageOut i [[stage_in]], texture2d<float> tex_0 [[texture(0)]], sampler smp_0 [[sampler(0)]], texture2d<float> tex_1 [[texture(1)]], sampler smp_1 [[sampler(1)]]) {
	return fs(FeatureVaryings{i.pos, i.uv, i.color, i.mode}, tex_0, smp_0, tex_1, smp_1);
}
