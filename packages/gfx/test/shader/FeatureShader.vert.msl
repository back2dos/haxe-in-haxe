#include <metal_stdlib>
using namespace metal;
struct FeatureVertex {
	float2 pos;
	float2 uv;
	float4 color;
	float mode;
};
struct FeatureVaryings {
	float4 pos;
	float2 uv;
	float4 color;
	float mode;
};
FeatureVaryings vs(FeatureVertex v) {
	return FeatureVaryings{float4(v.pos, 0.0, 1.0), v.uv, v.color, v.mode};
}
struct StageIn {
	float2 pos [[attribute(0)]];
	float2 uv [[attribute(1)]];
	float4 color [[attribute(2)]];
	float mode [[attribute(3)]];
};
struct StageOut {
	float4 pos [[position]];
	float2 uv [[user(locn0)]];
	float4 color [[user(locn1)]];
	float mode [[user(locn2)]];
};
vertex StageOut main0(StageIn i [[stage_in]]) {
	FeatureVaryings r = vs(FeatureVertex{i.pos, i.uv, i.color, i.mode});
	return StageOut{r.pos, r.uv, r.color, r.mode};
}
