#include <metal_stdlib>
using namespace metal;
struct TexVaryings {
	float4 pos;
	float2 uv;
	float lift;
};
struct Fade {
	float amount;
};
float4 tinted(texture2d<float> t, sampler t_smp, float2 uv) {
	return t.sample(t_smp, uv * 2.0) * float4(1.0, 0.5, 0.5, 1.0);
}
float4 fs(TexVaryings i, Fade fade, texture2d<float> albedo, sampler albedo_smp, texture2d<float> height, sampler height_smp) {
	return mix(tinted(albedo, albedo_smp, i.uv), height.sample(height_smp, i.uv, level(1.5)), float4(fade.amount)) * i.lift;
}
struct Fade_buffer {
	float amount;
};
struct StageOut {
	float4 pos [[position]];
	float2 uv [[user(locn0)]];
	float lift [[user(locn1)]];
};
fragment float4 main0(StageOut i [[stage_in]], constant Fade_buffer& u_1 [[buffer(1)]], texture2d<float> tex_2 [[texture(2)]], sampler smp_2 [[sampler(2)]], texture2d<float> tex_0 [[texture(0)]], sampler smp_0 [[sampler(0)]]) {
	return fs(TexVaryings{i.pos, i.uv, i.lift}, Fade{u_1.amount}, tex_2, smp_2, tex_0, smp_0);
}
