#include <metal_stdlib>
using namespace metal;
struct LitVertex {
	float3 pos;
	float3 normal;
	float2 uv;
};
struct Camera {
	float4x4 viewProj;
	float3 eye;
	float time;
};
struct LitVaryings {
	float3 normal;
	float4 clip;
	float2 uv;
	float shade;
};
float lambert(float3 n, float3 l) {
	return max(dot(normalize(n), normalize(l)), 0.0);
}
LitVaryings vs(LitVertex v, Camera cam) {
	float4 clip = cam.viewProj * float4(v.pos, 1.0);
	float wobble = sin(cam.time + (v.pos.x * 3.0)) * 0.05;
	float3 t = v.normal;
	float4 t_2 = clip + float4(wobble, 0.0, 0.0, 0.0);
	float2 t_3 = v.uv.yx;
	return LitVaryings{t, t_2, t_3, lambert(v.normal, cam.eye - v.pos)};
}
struct Camera_buffer {
	float4x4 viewProj;
	packed_float3 eye;
	float time;
};
struct StageIn {
	float3 pos [[attribute(0)]];
	float3 normal [[attribute(1)]];
	float2 uv [[attribute(2)]];
};
struct StageOut {
	float4 clip [[position]];
	float3 normal [[user(locn0)]];
	float2 uv [[user(locn1)]];
	float shade [[user(locn2)]];
};
vertex StageOut main0(StageIn i [[stage_in]], constant Camera_buffer& u_0 [[buffer(0)]]) {
	LitVaryings r = vs(LitVertex{i.pos, i.normal, i.uv}, Camera{u_0.viewProj, float3(u_0.eye), u_0.time});
	return StageOut{r.clip, r.normal, r.uv, r.shade};
}
