#include <metal_stdlib>
using namespace metal;
struct BuiltinVertex {
	float4 pos;
};
struct BuiltinVaryings {
	float4 pos;
	float a;
	float2 b;
};
BuiltinVaryings vs(BuiltinVertex v) {
	float4x4 m = float4x4(float4(1.0, 0.0, 0.0, 0.0), float4(0.0, 1.0, 0.0, 0.0), float4(0.0, 0.0, 1.0, 0.0), float4(v.pos.xyz, 1.0)) * float4x4(float4(0.5, 0.0, 0.0, 0.0), float4(0.0, 0.5, 0.0, 0.0), float4(0.0, 0.0, 0.5, 0.0), float4(0.0, 0.0, 0.0, 0.5));
	float4 t = (m * v.pos) + (m[3] * 0.0);
	float t_2 = v.pos.w;
	return BuiltinVaryings{t, t_2, v.pos.xy};
}
struct StageIn {
	float4 pos [[attribute(0)]];
};
struct StageOut {
	float4 pos [[position]];
	float a [[user(locn0)]];
	float2 b [[user(locn1)]];
};
vertex StageOut main0(StageIn i [[stage_in]]) {
	BuiltinVaryings r = vs(BuiltinVertex{i.pos});
	return StageOut{r.pos, r.a, r.b};
}
