#include <metal_stdlib>
using namespace metal;
struct Varyings {
	float4 pos;
	float3 color;
};
float4 fs(Varyings i) {
	return float4(i.color, 1.0);
}
struct StageOut {
	float4 pos [[position]];
	float3 color [[user(locn0)]];
};
fragment float4 main0(StageOut i [[stage_in]]) {
	return fs(Varyings{i.pos, i.color});
}
