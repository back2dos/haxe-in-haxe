#include <metal_stdlib>
using namespace metal;
struct InstanceVaryings {
	float4 pos;
	float3 color;
	float2 corner;
};
float4 fs(InstanceVaryings i) {
	return float4(i.color * (1.0 - (0.3 * length(i.corner))), 1.0);
}
struct StageOut {
	float4 pos [[position]];
	float3 color [[user(locn0)]];
	float2 corner [[user(locn1)]];
};
fragment float4 main0(StageOut i [[stage_in]]) {
	return fs(InstanceVaryings{i.pos, i.color, i.corner});
}
