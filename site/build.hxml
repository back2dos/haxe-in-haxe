# The site's JavaScript (`make site`): one file per bundle, into bin/site,
# compiled by the port. Run from the repository root.
-cp site/client
-dce full
-D js-es=6
--each

# the playground's page and its compiler's worker; the compiler page's tables
--main Playground
--js bin/site/playground.js

--next
--main Worker
--js bin/site/worker.js

--next
--main Tables
--js bin/site/tables.js

# the islands (@hxmc/web's DOM renderer): every page's, the examples' lab,
# and web's Counter example alone in its bundle
--next
-cp packages/view/src
-cp packages/web/src
-cp packages/web/examples
-cp site/islands
-D hxmc.view.renderer.dom=hxmc.web.DomRenderer
-D analyzer-optimize
--main SiteBundle
--js bin/site/site.js

--next
-cp packages/view/src
-cp packages/web/src
-cp packages/web/examples
-cp site/islands
-D hxmc.view.renderer.dom=hxmc.web.DomRenderer
-D analyzer-optimize
--main LabBundle
--js bin/site/lab.js

--next
-cp packages/view/src
-cp packages/web/src
-cp packages/web/examples
-D hxmc.view.renderer.dom=hxmc.web.DomRenderer
-D analyzer-optimize
--main Counter
--js bin/site/counter.js
