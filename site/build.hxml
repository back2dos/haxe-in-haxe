# The website's scripts (`make site`): one JavaScript file per page script,
# into bin/site. Run from the repository root.
-cp site/src
-dce full
-D js-es=6
--each

--main Playground
--js bin/site/playground.js

--next
--main Worker
--js bin/site/worker.js

--next
--main Tables
--js bin/site/tables.js
